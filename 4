# --- ЗАДАНИЕ 2: ПЕРЕКЛЮЧЕНИЕ ЭКРАНОВ ---

# 1. При запуске программы сразу прячем рамку с ответами. 
# Иначе обе рамки наложатся друг на друга, и будет каша.
AnsGroupBox.hide()

# 2. Функция, которая показывает РЕЗУЛЬТАТ
def show_result():
    '''Показать панель ответов'''
    RadioGroupBox.hide()          # Прячем рамку с вопросами
    AnsGroupBox.show()            # Показываем рамку с ответами
    btn_OK.setText('Следующий вопрос') # Меняем текст кнопки, чтобы она вела нас дальше

# 3. Функция, которая показывает ВОПРОС
def show_question():
    '''Показать панель вопросов'''
    RadioGroupBox.show()          # Показываем рамку с вопросами
    AnsGroupBox.hide()            # Прячем рамку с ответами
    btn_OK.setText('Ответить')    # Возвращаем кнопке текст "Ответить"
    
    # ХИТРЫЙ ТРЮК: Чтобы сбросить галочки с кнопок.
    # Если просто написать rbtn_1.setChecked(False), это не сработает, 
    # потому что кнопки объединены в группу (RadioGroup). 
    # Группа не дает снять выбор со всех кнопок сразу (всегда должна быть выбрана одна).
    RadioGroup.setExclusive(False) # Временно "разбиваем" группу
    rbtn_1.setChecked(False)       # Снимаем галочки со всех кнопок
    rbtn_2.setChecked(False)
    rbtn_3.setChecked(False)
    rbtn_4.setChecked(False)
    RadioGroup.setExclusive(True)  # Снова "собираем" группу (теперь снова можно выбрать только одну)

# 4. Функция-ДИСПЕТЧЕР (как на скриншоте в методичке)
# Она смотрит на текст кнопки и решает, какую функцию вызвать.
def start_test():
    if btn_OK.text() == 'Ответить':
        show_result()   # Если написано "Ответить", показываем результат
    else:
        show_question() # Если написано "Следующий вопрос", показываем новый вопрос

# 5. Привязываем нажатие на кнопку к функции-диспетчеру
btn_OK.clicked.connect(start_test)
