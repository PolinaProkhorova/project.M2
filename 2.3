import sys
from random import shuffle
from PyQt5.QtCore import Qt
from PyQt5.QtWidgets import (
    QApplication,
    QWidget,
    QHBoxLayout,
    QVBoxLayout,
    QGroupBox,
    QRadioButton,
    QPushButton,
    QLabel,
    QButtonGroup,
)

app = QApplication([])

btn_OK = QPushButton('Ответить')
lb_Question = QLabel('Самый сложный вопрос в мире!')

layout_line1 = QHBoxLayout()
layout_line2 = QHBoxLayout()
layout_line3 = QHBoxLayout()

layout_line1.addWidget(lb_Question, alignment=(Qt.AlignHCenter | Qt.AlignVCenter))

layout_line3.addStretch(1)
layout_line3.addWidget(btn_OK, stretch=2)
layout_line3.addStretch(1)

RadioGroupBox = QGroupBox('Варианты ответов')
rbtn_1 = QRadioButton('Вариант 1')
rbtn_2 = QRadioButton('Вариант 2')
rbtn_3 = QRadioButton('Вариант 3')
rbtn_4 = QRadioButton('Вариант 4')

RadioGroup = QButtonGroup()
RadioGroup.addButton(rbtn_1)
RadioGroup.addButton(rbtn_2)
RadioGroup.addButton(rbtn_3)
RadioGroup.addButton(rbtn_4)

layout_ans1 = QHBoxLayout()
layout_ans2 = QVBoxLayout()
layout_ans3 = QVBoxLayout()

layout_ans2.addWidget(rbtn_1)
layout_ans2.addWidget(rbtn_2)
layout_ans3.addWidget(rbtn_3)
layout_ans3.addWidget(rbtn_4)

layout_ans1.addLayout(layout_ans2)
layout_ans1.addLayout(layout_ans3)

RadioGroupBox.setLayout(layout_ans1)
layout_line2.addWidget(RadioGroupBox)

AnsGroupBox = QGroupBox('Результат теста')
lb_Result = QLabel('прав ты или нет?')
lb_Correct = QLabel('ответ будет тут!')

layout_res = QVBoxLayout()

layout_res.addWidget(lb_Result, alignment=(Qt.AlignLeft | Qt.AlignTop))
layout_res.addWidget(lb_Correct, alignment=Qt.AlignHCenter, stretch=2)

AnsGroupBox.setLayout(layout_res)
layout_line2.addWidget(AnsGroupBox)

AnsGroupBox.hide()

def show_result():
    RadioGroupBox.hide()
    AnsGroupBox.show()
    btn_OK.setText('Следующий вопрос')

def show_question():
    RadioGroupBox.show()
    AnsGroupBox.hide()
    btn_OK.setText('Ответить')

    RadioGroup.setExclusive(False)
    rbtn_1.setChecked(False)
    rbtn_2.setChecked(False)
    rbtn_3.setChecked(False)
    rbtn_4.setChecked(False)
    RadioGroup.setExclusive(True)

answers = [rbtn_1, rbtn_2, rbtn_3, rbtn_4]

def ask(question, right_answer, wrong1, wrong2, wrong3):
    shuffle(answers)  # новое: перемешиваем список кнопок перед записью текста (как на 1-м и 3-м слайдах)
    answers[0].setText(right_answer)  # новое: в первую случайную кнопку записываем правильный ответ
    answers[1].setText(wrong1)  # новое: в остальные кнопки записываем неправильные варианты
    answers[2].setText(wrong2)
    answers[3].setText(wrong3)

    lb_Question.setText(question)
    lb_Correct.setText(right_answer)
    show_question()

def show_correct(res):  # новое: добавили отдельную функцию для отображения результата проверки (со слайда №3)
    lb_Result.setText(res)  # новое: записываем переданный текст ('Правильно!' или 'Неправильно!') в надпись результата
    show_result()  # новое: показываем панель ответа и меняем надпись на кнопке

def check_answer():
    if answers[0].isChecked():
        show_correct('Правильно!')  # новое: заменили прямое изменение текста и вызов show_result() на вызов новой функции show_correct
    else:  # новое: упростили проверку остальных вариантов по логике со слайда №3
        if answers[1].isChecked() or answers[2].isChecked() or answers[3].isChecked():  # новое: проверяем, нажата ли любая из неправильных кнопок
            show_correct('Неправильно!')  # новое: вызываем функцию показа результата с пометкой 'Неправильно!'

def start_test():
    if btn_OK.text() == 'Ответить':
        check_answer()
    else:
        show_question()

btn_OK.clicked.connect(start_test)

ask('Государственный язык Бразилии', 'Португальский', 'Бразильский', 'Испанский', 'Итальянский')

layout_card = QVBoxLayout()

layout_card.addLayout(layout_line1, stretch=2)
layout_card.addLayout(layout_line2, stretch=8)
layout_card.addStretch(1)
layout_card.addLayout(layout_line3, stretch=1)
layout_card.addStretch(1)
layout_card.setSpacing(5)

window = QWidget()
window.setLayout(layout_card)
window.setWindowTitle('Memory Card')
window.resize(400, 300)
window.show()

app.exec_()
